{
  "manifest_version": 3,
  "name": "OLX Ad Blocker — Hide Elite & Paid Ads",
  "short_name": "OLX Ad Blocker",
  "version": "1.0.0",
  "description": "Hides all paid ads on olx.in — Elite (Elite Seller), Featured, Sponsored and promoted listings — plus banner/ad slots and ad network requests.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "OLX Ad Blocker",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage", "declarativeNetRequest"],
  "host_permissions": ["*://*.olx.in/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.olx.in/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["*://*.olx.in/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "olx_ad_networks",
        "enabled": true,
        "path": "rules/ad-rules.json"
      }
    ]
  }
}
